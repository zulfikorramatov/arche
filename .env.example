APP_NAME=arche
APP_ENV=local

HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=10s
HTTP_SHUTDOWN_TIMEOUT=15s

LOG_LEVEL=info

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
POSTGRES_SSL_MODE=disable
POSTGRES_MAX_CONNS=10
POSTGRES_MIN_CONNS=1
POSTGRES_CONN_TIMEOUT=5s
POSTGRES_RETRY_DELAY=5s
POSTGRES_MAX_ATTEMPTS=5

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_PREFIX=
REDIS_POOL_SIZE=10
REDIS_DIAL_TIMEOUT=1s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s
REDIS_RETRY_DELAY=3s
REDIS_MAX_ATTEMPTS=5

REDIS_SENTINEL_HOST_1=
REDIS_SENTINEL_HOST_2=
REDIS_SENTINEL_HOST_3=
REDIS_SENTINEL_PORT=26379
REDIS_SENTINEL_SERVICE=mymaster
REDIS_SENTINEL_PASSWORD=
REDIS_SENTINEL_ENABLED=false

KAFKA_BROKERS=localhost:19092
KAFKA_GROUP_ID=arche
KAFKA_TOPICS=arche.example
KAFKA_DIAL_TIMEOUT=10s
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_MAX_RETRIES=3
KAFKA_RETRY_BACKOFF=2s

ELASTIC_APM_SERVER_URL=http://localhost:8200
ELASTIC_APM_SERVICE_NAME=arche
ELASTIC_APM_ENVIRONMENT=local
ELASTIC_APM_SECRET_TOKEN=
