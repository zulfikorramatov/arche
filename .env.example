# App
APP_NAME=arche
APP_ENV=local

# HTTP
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=10s
HTTP_SHUTDOWN_TIMEOUT=15s

# Logger
LOG_LEVEL=info

# Postgres (use "postgres" host inside docker; docker-compose overrides this
# for the app container — keep localhost here so `make run` works on the host)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
POSTGRES_SSL_MODE=disable
POSTGRES_MAX_CONNS=10
POSTGRES_MIN_CONNS=1
POSTGRES_CONN_TIMEOUT=5s

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_PREFIX=
REDIS_POOL_SIZE=10
REDIS_DIAL_TIMEOUT=5s

REDIS_SENTINEL_HOST_1=
REDIS_SENTINEL_HOST_2=
REDIS_SENTINEL_HOST_3=
REDIS_SENTINEL_PORT=26379
REDIS_SENTINEL_SERVICE=mymaster
REDIS_SENTINEL_PASSWORD=
REDIS_SENTINEL_ENABLED=false

# Elastic APM
ELASTIC_APM_SERVER_URL=http://localhost:8200
ELASTIC_APM_SERVICE_NAME=arche
ELASTIC_APM_ENVIRONMENT=local
ELASTIC_APM_SECRET_TOKEN=
